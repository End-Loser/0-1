{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostWriterDependencyGate",
  "type": "object",
  "required": ["project_id", "chapter", "version", "complete", "root_ids", "nodes", "current_index", "frozen", "p17c"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "chapter": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "minLength": 1},
    "complete": {"const": true},
    "current_index": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "root_ids": {"$ref": "#/$defs/ids"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "version", "path", "sha256", "depends_on"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/hash"},
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "frozen": {"$ref": "#/$defs/binding"},
    "p17c": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
