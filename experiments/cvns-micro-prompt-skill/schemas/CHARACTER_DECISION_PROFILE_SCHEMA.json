{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CharacterDecisionProfile",
  "type": "object",
  "required": [
    "artifact_id",
    "task_id",
    "status",
    "entity_id",
    "actor_class",
    "stable_tendencies",
    "value_priorities",
    "decision_patterns",
    "blind_spots",
    "evidence_refs",
    "unknowns"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "task_id": {
      "const": "P05E"
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "VALIDATED",
        "FROZEN",
        "REJECTED",
        "NOT_APPLICABLE",
        "INSUFFICIENT_BASIS"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "actor_class": {
      "enum": [
        "PERSON",
        "ORGANIZATION",
        "AUTONOMOUS_AGENT",
        "NON_DECISIONAL"
      ]
    },
    "stable_tendencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tendency_id",
          "tendency",
          "trigger_conditions",
          "behavioral_manifestation",
          "boundary_or_counterexample",
          "evidence_refs",
          "certainty"
        ],
        "properties": {
          "tendency_id": {
            "type": "string",
            "minLength": 1
          },
          "tendency": {
            "type": "string",
            "minLength": 1
          },
          "trigger_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "behavioral_manifestation": {
            "type": "string",
            "minLength": 1
          },
          "boundary_or_counterexample": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "certainty": {
            "enum": [
              "ESTABLISHED",
              "SUPPORTED_INFERENCE",
              "HYPOTHESIS"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "value_priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "priority_or_tradeoff",
          "evidence_refs"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "priority_or_tradeoff": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decision_patterns": {
      "type": "object",
      "properties": {
        "risk_posture": {
          "type": "string"
        },
        "uncertainty_handling": {
          "type": "string"
        },
        "trust_strategy": {
          "type": "string"
        },
        "conflict_response": {
          "type": "string"
        },
        "pressure_response": {
          "type": "string"
        }
      },
      "required": [
        "risk_posture",
        "uncertainty_handling",
        "trust_strategy",
        "conflict_response",
        "pressure_response"
      ],
      "additionalProperties": false
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "blind_spot",
          "manifestation",
          "evidence_refs"
        ],
        "properties": {
          "blind_spot": {
            "type": "string"
          },
          "manifestation": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "moral_or_operational_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "boundary",
          "basis"
        ],
        "properties": {
          "boundary": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "temporary_state_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "design_notes": [
    "This is a stable decision-support sidecar, not a 12th BASE dimension or a timeline.",
    "Time-varying mood, belief, desire, relationship and knowledge remain in existing BASE lines.",
    "Traits are tendencies, not deterministic rules; unknown traits must not be invented.",
    "Each tendency has a profile-local tendency_id; P13C references it as profile_ref::tendency_id. Tendencies are preferences, not deterministic rules."
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "VALIDATED",
              "FROZEN"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stable_tendencies": {
            "minItems": 1
          },
          "value_priorities": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "NOT_APPLICABLE",
              "INSUFFICIENT_BASIS"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "unknowns": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
