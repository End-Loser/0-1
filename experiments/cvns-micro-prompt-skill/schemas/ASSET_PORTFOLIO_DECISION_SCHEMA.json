{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetPortfolioDecision",
  "description": "source_asset_ids refer to candidate StoryAsset.asset_id domain values, never P12 artifact_id values. The host checks source membership and exact copied phase targets before approval.",
  "type": "object",
  "required": [
    "artifact_id",
    "task_id",
    "status",
    "scope_ref",
    "selected_assets",
    "merged_groups",
    "deferred_assets",
    "rejected_assets",
    "decision_summary"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "const": "P12B"
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "VALIDATED",
        "FROZEN",
        "REJECTED"
      ]
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "selected_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "source_asset_ids",
          "unique_reader_value",
          "required_phases",
          "phase_chapters",
          "reason"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "source_asset_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unique_reader_value": {
            "type": "string",
            "minLength": 1
          },
          "required_phases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "SETUP",
                "REVEAL",
                "PAYOFF"
              ]
            },
            "minItems": 1
          },
          "phase_chapters": {
            "type": "object",
            "required": [
              "SETUP",
              "REVEAL",
              "PAYOFF"
            ],
            "properties": {
              "SETUP": {
                "type": "integer",
                "minimum": 1
              },
              "REVEAL": {
                "type": "integer",
                "minimum": 1
              },
              "PAYOFF": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "merged_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "source_asset_ids",
          "canonical_asset_id",
          "preserved_distinct_functions",
          "merge_reason"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "source_asset_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "canonical_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "preserved_distinct_functions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "merge_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "deferred_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "reason",
          "revisit_condition"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "revisit_condition": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "rejected_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "reason",
          "revisit_condition"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "revisit_condition": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "decision_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
