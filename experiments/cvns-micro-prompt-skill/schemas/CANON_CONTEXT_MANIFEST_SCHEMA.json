{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostCanonContextManifest",
  "type": "object",
  "required": ["project_id", "chapter", "version", "mode", "canon", "current_index"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "chapter": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["generator", "writer", "audit"]},
    "canon": {"$ref": "#/$defs/source"},
    "outline": {"$ref": "#/$defs/source"},
    "base_lines": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "entity_ids": {"$ref": "#/$defs/ids"},
    "required_line_ids": {"$ref": "#/$defs/ids"},
    "budget_lines": {"type": "integer", "minimum": 1},
    "current_index": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "required": ["artifact_id", "version", "path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
