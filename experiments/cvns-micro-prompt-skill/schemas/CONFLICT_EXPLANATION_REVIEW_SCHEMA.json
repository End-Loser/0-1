{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConflictExplanationReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "task_id", "status", "source_candidate_ref", "candidate_set_ref", "decision", "selected_hypothesis_id", "reviews", "comparison_reason", "unresolved_gaps"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "task_id": {"const": "P11B"},
    "status": {"enum": ["DRAFT", "REVIEW", "VALIDATED", "FROZEN"]},
    "source_candidate_ref": {"type": "string", "minLength": 1},
    "candidate_set_ref": {"type": "string", "minLength": 1},
    "decision": {"enum": ["PROPOSE_REVISION", "REPAIR_REQUIRED", "NEEDS_EVIDENCE", "NO_DESIGN_VALUE"]},
    "selected_hypothesis_id": {"type": ["string", "null"]},
    "comparison_reason": {"type": "string", "minLength": 1},
    "unresolved_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "verdict", "checks", "counterexample", "required_revisions"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["ACCEPT_FOR_REVISION", "REJECT", "UNRESOLVED"]},
          "counterexample": {"type": "string", "minLength": 1},
          "required_revisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_coverage", "no_silent_rewrite", "genre_boundary", "rule_consistency", "causal_feasibility", "bounded_effect", "cross_line_effects", "reader_fairness", "narrative_gain"],
            "properties": {
              "claim_coverage": {"$ref": "#/$defs/check"},
              "no_silent_rewrite": {"$ref": "#/$defs/check"},
              "genre_boundary": {"$ref": "#/$defs/check"},
              "rule_consistency": {"$ref": "#/$defs/check"},
              "causal_feasibility": {"$ref": "#/$defs/check"},
              "bounded_effect": {"$ref": "#/$defs/check"},
              "cross_line_effects": {"$ref": "#/$defs/check"},
              "reader_fairness": {"$ref": "#/$defs/check"},
              "narrative_gain": {"$ref": "#/$defs/check"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason", "evidence_refs"],
      "properties": {
        "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
